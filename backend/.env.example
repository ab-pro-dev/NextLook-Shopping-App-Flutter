# Database Connection String
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET="your-access-token-secret-here"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-here"

# Server Port (assigned dynamically by Render, defaults to 3000 locally)
PORT=3000

# Telebirr C2B WebCheckout Integration Sandbox Credentials
TELEBIRR_BASE_URL="https://app.telebirr.et:8443/am-cop-gate/api/v1"
TELEBIRR_WEB_BASE_URL="https://app.telebirr.et:8443/am-cop-gate/pay?"
TELEBIRR_FABRIC_APP_ID="your-fabric-app-id"
TELEBIRR_APP_SECRET="your-app-secret"
TELEBIRR_MERCHANT_APP_ID="your-merchant-app-id"
TELEBIRR_MERCHANT_CODE="your-merchant-code"
TELEBIRR_SHORT_CODE="your-short-code"
TELEBIRR_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-rsa-private-key\n-----END RSA PRIVATE KEY-----"
TELEBIRR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour-telebirr-public-key\n-----END PUBLIC KEY-----"
